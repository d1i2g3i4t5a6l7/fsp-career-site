# Скопировать в .env. Ключи — только в .env, не в git.

# stub — заглушка без сети; live — реальные модели
LLM_MODE=stub

# Каналы для ассистента и судьи: gigachat | cloudru | lightning. Не настроенный канал уходит в LLM_FALLBACK.
ROUTE_ASSISTANT=gigachat
ROUTE_GRADER=gigachat
ROUTE_TASK_GEN=gigachat
LLM_FALLBACK=gigachat

# Прогонов судьи на попытку (итог по критерию — большинство); 1 — дешевле по токенам
GRADER_RUNS=3

GRADE_CHANGE_COOLDOWN_DAYS=90
SAME_LEVEL_RETRY_DAYS=30

# API Сбера: ключ авторизации из личного кабинета (Base64 client_id:secret)
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Цепочка НУЦ Минцифры уже в certs/ и подключается сама; сюда — только дополнительный PEM, если понадобится
GIGACHAT_CA_BUNDLE=
# false — не проверять сертификат Сбера. Не нужно: цепочка Минцифры есть в репозитории
GIGACHAT_VERIFY_SSL=true
# У физлица — 1 одновременный запрос, у юрлица — 10
GIGACHAT_MAX_CONCURRENCY=1

# cloud.ru Foundation Models; id моделей: GET https://foundation-models.api.cloud.ru/v1/models
CLOUDRU_API_KEY=
CLOUDRU_MODEL=ai-sage/GigaChat3.5-432B-A28B-Reasoning
CLOUDRU_MAX_CONCURRENCY=4

# Свой сервер с Lightning: vLLM, llama-server или Ollama (OpenAI-совместимый адрес, например http://localhost:11434/v1)
LIGHTNING_BASE_URL=
LIGHTNING_MODEL=

# local — запуск кода на машине (только разработка); piston — песочница без сети по API Piston.
# В docker compose обе настройки и DATABASE_URL задаются в compose.yaml, отсюда не берутся
SANDBOX=local
PISTON_URL=http://localhost:2000
# Пакеты в песочнице сверх стандартной библиотеки — их сможет использовать генератор задач, например ["numpy","pandas"]
SANDBOX_PACKAGES=[]
# Сколько раз модель может исправить черновик задачи после проваленных проверок
TASK_GEN_FIX_ATTEMPTS=3

DATABASE_URL=sqlite+aiosqlite:///./workspace.db
